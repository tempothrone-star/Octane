{
  "name": "octane-openclaw",
  "version": "0.1.0",
  "private": false,
  "description": "OpenClaw extension and portable Octance skill package",
  "type": "module",
  "files": [
    "openclaw/index.js",
    "openclaw/README.md",
    "openclaw.plugin.json",
    "octance/SKILL.md",
    "octance/references/**",
    "octance/scripts/octance.py",
    "octance/scripts/octance/*.py",
    "octance/scripts/octance/migrations/*.sql",
    "octane/*.py",
    "scripts/octance.py",
    "README.md",
    "docs/architecture.md",
    "docs/openclaw.md",
    "pyproject.toml"
  ],
  "dependencies": {
    "typebox": "^1.4.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "openclaw": {
    "extensions": [
      "./openclaw/index.js"
    ],
    "runtimeExtensions": [
      "./openclaw/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": "2026.5.17"
    }
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  }
}
