{
  "name": "octane-openclaw",
  "version": "0.1.0",
  "private": false,
  "description": "Octane project intelligence, function tracing, and evidence-driven repairs for OpenClaw",
  "type": "module",
  "files": [
    "SKILL.md",
    "openclaw/*.js",
    "openclaw/README.md",
    "openclaw.plugin.json",
    "octane/*.py",
    "octane/*.cjs",
    "octane/*.rb",
    "scripts/octance.py",
    "README.md",
    "docs/*.md",
    "pyproject.toml",
    "references/*.md",
    "octane/ledger/*.py",
    "octane/ledger/migrations/*.sql",
    "scripts/octane.py",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "mcp/*.js",
    "examples/*.jsonl"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:python": "python3 -m unittest discover -s tests -v"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "typebox": "^1.4.7"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "openclaw": {
    "extensions": [
      "./openclaw/index.js"
    ],
    "runtimeExtensions": [
      "./openclaw/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": "2026.5.17"
    }
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "license": "MIT",
  "bin": {
    "octane-mcp": "mcp/server.js"
  }
}
