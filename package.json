{
  "name": "octane-openclaw",
  "version": "0.1.0",
  "description": "OpenClaw plugin and companion skill for project intelligence",
  "type": "module",
  "files": [
    "openclaw/index.js",
    "openclaw/skills/**",
    "openclaw/README.md",
    "openclaw.plugin.json",
    "octane/*.py",
    "README.md",
    "docs/architecture.md",
    "docs/openclaw.md",
    "pyproject.toml"
  ],
  "dependencies": {
    "typebox": "^1.4.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "openclaw": {
    "extensions": ["./openclaw/index.js"],
    "runtimeExtensions": ["./openclaw/index.js"],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": "2026.5.17"
    }
  }
}
